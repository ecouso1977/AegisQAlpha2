{
  "name": "CollabSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "col": {
            "type": "number"
          },
          "last_seen": {
            "type": "number"
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "session_id",
    "file_name"
  ]
}